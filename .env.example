# Copy to .env and adjust, then use with docker compose

# --- PBS connection ---
PBS_HOST=pbs.example.com
PBS_DATASTORE=backup
PBS_USER=root
PBS_REALM=pam

# Server certificate fingerprint (recommended, enable TLS verification)
#PBS_FINGERPRINT=00:aa:bb:cc:dd:ee:ff

# --- Password (prefer a Docker secret; this is the env-var fallback) ---
PBS_PASSWORD=change-me

# --- Backup options ---
BACKUP_ID=appdata
BACKUP_NS=default

# --- Schedule (standard 5-field cron) ---
CRON_SCHEDULE=0 3 * * *

# Optional: timezone for the container
#TZ=UTC
